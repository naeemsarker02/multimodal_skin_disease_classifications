        <mxCell id="cont1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#F57C00;shadow=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tok1" value="Tok 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#F57C00;fontSize=14;fontStyle=1;direction=north;" vertex="1" parent="1">
          <mxGeometry x="55" y="260" width="45" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tok2" value="Tok 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#F57C00;fontSize=14;fontStyle=1;direction=north;" vertex="1" parent="1">
          <mxGeometry x="110" y="260" width="45" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tokdots" value="- - - -" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="295" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tok49" value="Tok 49" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#F57C00;fontSize=14;fontStyle=1;direction=north;" vertex="1" parent="1">
          <mxGeometry x="215" y="260" width="65" height="95" as="geometry" />
        </mxCell>
        <mxCell id="contlabel1" value="49 Spatial Tokens (1280-d each)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontStyle=2;fontColor=#5D4037;" vertex="1" parent="1">
          <mxGeometry x="40" y="245" width="260" height="20" as="geometry" />
        </mxCell>

        <!-- ===== NEW: METADATA-CONDITIONED CHANNEL GATE ===== -->
        <mxCell id="gate1" value="Metadata-Conditioned Channel Gate&#10;Sigmoid(Linear(metadata)) x Image Tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#AD1457;fontColor=#4A0E2A;fontSize=14;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="Key / Value Projection&#10;(1280-d to 256-d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#1565C0;fontColor=#0D2B4E;fontSize=16;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT COLUMN: METADATA PATH ===== -->
        <mxCell id="t2" value="Clinical Metadata" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#3E2723;fontSize=18;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="30" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="Metadata MLP&#10;(89-d to 64-d Encoder)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontColor=#1B3A1E;fontSize=17;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="130" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cont2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#6A3FA0;shadow=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="240" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="qbox" value="Query" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#6A3FA0;fontSize=15;fontStyle=1;direction=north;" vertex="1" parent="1">
          <mxGeometry x="770" y="260" width="120" height="95" as="geometry" />
        </mxCell>
        <mxCell id="contlabel2" value="Metadata Embedding (64-d)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontStyle=2;fontColor=#5D4037;" vertex="1" parent="1">
          <mxGeometry x="700" y="245" width="260" height="20" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="Query Projection&#10;(64-d to 256-d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontColor=#1B3A1E;fontSize=16;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="520" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- ===== MERGE: CROSS-ATTENTION ===== -->
        <mxCell id="core" value="Cross-Attention Fusion Block&#10;8 Attention Heads, d_model = 256&#10;Query = Metadata  |  Key / Value = Gated Image Tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontColor=#FFFFFF;fontSize=17;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="650" width="480" height="110" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="Concatenation&#10;(320-d Joint Vector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF9A9A;strokeColor=#C62828;fontColor=#3E1010;fontSize=17;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="810" width="420" height="65" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="Classifier&#10;FC(128) - BatchNorm - ReLU - Dropout - FC(6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#616161;fontColor=#212121;fontSize=16;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="925" width="420" height="70" as="geometry" />
        </mxCell>

        <mxCell id="out1" value="Predicted Class&#10;(6-way Diagnosis)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1B1B1B;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="1035" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS ===== -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5D4037;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="t1" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5D4037;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="e1" target="cont1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#AD1457;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="cont1" target="gate1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#AD1457;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="gate1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- cross-connection: metadata embedding feeds the gate -->
        <mxCell id="gatefeed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#AD1457;strokeWidth=2;dashed=1;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="cont2" target="gate1">
          <mxGeometry relative="1" as="geometry">
