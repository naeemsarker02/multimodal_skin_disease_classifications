<mxfile host="app.diagrams.net">
  <diagram name="Proposed Architecture" id="arch4">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== LEFT COLUMN: IMAGE PATH ===== -->
        <mxCell id="t1" value="Input Image" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontColor=#3E2723;fontSize=18;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="260" height="60" as="geometry" />
