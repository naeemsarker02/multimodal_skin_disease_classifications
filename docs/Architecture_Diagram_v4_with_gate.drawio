        <mxCell id="e1" value="EfficientNet-B0&#10;(Pre-trained Image Encoder)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90CAF9;strokeColor=#1565C0;fontColor=#0D2B4E;fontSize=17;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="260" height="70" as="geometry" />
