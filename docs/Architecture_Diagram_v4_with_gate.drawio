        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5D4037;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="t2" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5D4037;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="e2" target="cont2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5D4037;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="cont2" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1565C0;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="p1" target="core"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="p2" target="core"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6A1B9A;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="core" target="f1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C62828;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="f1" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#616161;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="c1" target="out1"><mxGeometry relative="1" as="geometry" /></mxCell>

