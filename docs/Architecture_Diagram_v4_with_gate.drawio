        <mxCell id="gatefeedlabel" value="gate input" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontStyle=2;fontColor=#AD1457;" vertex="1" parent="1">
          <mxGeometry x="420" y="360" width="150" height="20" as="geometry" />
